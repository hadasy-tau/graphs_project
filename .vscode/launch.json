{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Smoke test: full pipeline (debug)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/tests/test_pipeline_smoke.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    },
    {
      "name": "Smoke test: under pytest",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["tests/test_pipeline_smoke.py", "-s"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    },
    {
      "name": "Rebuild test fixture from HF dataset",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/tests/fixtures/build_fixture.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    }
  ]
}
